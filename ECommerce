import java.util.ArrayList;
import java.util.Scanner;

// Product class with multiple constructors
class Product {
    String name;
    double price;
    int quantity;

    // Default constructor
    Product() {
        this.name = "Unknown";
        this.price = 0.0;
        this.quantity = 0;
    }

    // Constructor with name only
    Product(String name) {
        this.name = name;
        this.price = 0.0;
        this.quantity = 0;
    }

    // Constructor with name and price
    Product(String name, double price) {
        this.name = name;
        this.price = price;
        this.quantity = 0;
    }

    // Constructor with all details
    Product(String name, double price, int quantity) {
        this.name = name;
        this.price = price;
        this.quantity = quantity;
    }

    // Method to calculate subtotal
    double calculateSubtotal() {
        return price * quantity;
    }
}

// Order class to manage products
class Order {
    ArrayList<Product> products = new ArrayList<>();

    void addProduct(Product p) {
        products.add(p);
    }

    double calculateTotal() {
        double total = 0;
        for (Product p : products) {
            total += p.calculateSubtotal();
        }
        return total;
    }

    double applyDiscount(double total) {
        if (total > 5000) {
            return total * 0.90; // 10% discount
        } else if (total > 3000) {
            return total * 0.95; // 5% discount
        }
        return total; // no discount
    }

    void generateInvoice() {
        System.out.println("\n===== INVOICE =====");
        System.out.printf("%-15s %-10s %-10s %-10s\n", "Item", "Qty", "Price", "Subtotal");
        System.out.println("-----------------------------------------------");

        for (Product p : products) {
            System.out.printf("%-15s %-10d %-10.2f %-10.2f\n",
                    p.name, p.quantity, p.price, p.calculateSubtotal());
        }

        double total = calculateTotal();
        double discountedTotal = applyDiscount(total);

        System.out.println("-----------------------------------------------");
        System.out.printf("Total before discount: %.2f\n", total);
        if (discountedTotal != total) {
            System.out.printf("Discount applied: %.2f\n", total - discountedTotal);
        }
        System.out.printf("Final Amount: %.2f\n", discountedTotal);
        System.out.println("===============================");
    }
}

// Main driver class with entry point
public class ECommerceSystem {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Order order = new Order();

        System.out.print("Enter number of products: ");
        int n = sc.nextInt();
        sc.nextLine(); // consume newline

        for (int i = 0; i < n; i++) {
            System.out.println("\nEnter details for product " + (i + 1));
            System.out.print("Name: ");
            String name = sc.nextLine();
            System.out.print("Price: ");
            double price = sc.nextDouble();
            System.out.print("Quantity: ");
            int qty = sc.nextInt();
            sc.nextLine(); // consume newline

            Product p = new Product(name, price, qty); // using overloaded constructor
            order.addProduct(p);
        }

        order.generateInvoice();
        sc.close();
    }
}
